# ============================================================
#  بصمة — إعدادات البيئة
#  انسخ هذا الملف إلى .env وعبّئ القيم
# ============================================================

# --- الدخول (مستخدم واحد) ---
# كلمة المرور التي تدخل بها للتطبيق من أي جهاز
APP_PASSWORD=change-me-now
# سر توقيع جلسة الدخول. أنشئه بالأمر:  openssl rand -hex 32
AUTH_SECRET=replace-with-64-hex-characters

# --- مفاتيح الذكاء الاصطناعي ---
# Anthropic (الكتابة والتعلم والتحليل)  https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Google Gemini (توليد الصور)  https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxx

# --- النماذج (اختياري) ---
# نموذج Claude للكتابة والتعلم. الافتراضي: claude-opus-5
CLAUDE_MODEL=claude-opus-5
# نموذج Gemini للصور. الافتراضي: gemini-3.1-flash-image (Nano Banana 2)
# للجودة الأعلى مع تكلفة أكبر: gemini-3-pro-image-preview (Nano Banana Pro)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- التحقق من نظام العمل السعودي ---
# auto   = يُفحص فقط إذا كان التخصص موارد بشرية أو ذُكرت مصطلحات قانونية (الافتراضي)
# always = يُفحص كل بوست
# off    = معطّل
LABOR_LAW_CHECK=auto

# --- التخزين ---
# مجلد قاعدة البيانات والصور. داخل Docker يكون /data (مربوط بـ volume)
DATA_DIR=./data

# --- للتطوير فقط ---
# BASMA_MOCK_AI=1  يعطّل الاتصال بالنماذج ويرجّع نتائج وهمية لاختبار الواجهة بدون مفاتيح
